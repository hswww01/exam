# Copy to .env.local and fill in the key locally. Never commit real keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT=900

# Optional server-side HTTP or SOCKS5 proxy; keep credentials in .env.local only.
OPENAI_PROXY=
